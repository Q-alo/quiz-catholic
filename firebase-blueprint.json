{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "lastLoginAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "backupData": {
          "type": "string"
        },
        "storageUsedBytes": {
          "type": "number"
        },
        "dailyGeminiCalls": {
          "type": "number"
        },
        "recentApiTimestamps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ApiUsageStats": {
      "title": "API Usage Stats",
      "description": "Global API usage tracking",
      "type": "object",
      "properties": {
        "flash_lite": { "type": "number" },
        "flash": { "type": "number" },
        "flash_3_5": { "type": "number" },
        "callLogs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "string" },
              "email": { "type": "string" },
              "model": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "stats/{docId}": {
      "schema": "ApiUsageStats",
      "description": "API Usage Stats documents"
    }
  }
}
